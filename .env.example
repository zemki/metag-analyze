# -----------------------------------------------------------------------------
# CORE APP SETTINGS
# -----------------------------------------------------------------------------
APP_NAME="Metag Analyze"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_OWNER="ZeMKI, Universität Bremen"

# Vite environment mode
VITE_ENV_MODE=development

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
# Set to true to force all API requests to use V2 format (entity field)
FORCE_API_V2=false
API_V2_CUTOFF_DATE=2025-03-21

# -----------------------------------------------------------------------------
# FIREBASE CONFIGURATION
# -----------------------------------------------------------------------------
# Path to Firebase credentials file (relative to storage/app/)
FIREBASE_CREDENTIALS=
FIREBASE_URL=

# Firebase Cloud Messaging API key for push notifications
FCM_API_KEY=

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_CHANNEL=daily

# -----------------------------------------------------------------------------
# DATABASE - MAIN
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=metagtesting
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# DATABASE - MART (Separate MART data storage)
# -----------------------------------------------------------------------------
MART_DB_DATABASE=metagtesting_mart

# -----------------------------------------------------------------------------
# CACHING
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MAIL CONFIGURATION
# -----------------------------------------------------------------------------
# Which mailer to use: smtp | sendmail | log | array | failover
# `log` writes messages to the log instead of sending them - useful locally,
# never what you want in production.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional. Leave MAIL_SCHEME unset for the normal case: port 465 selects
# implicit TLS (smtps) and STARTTLS is negotiated automatically on 587.
#MAIL_SCHEME=
# Name announced in the SMTP EHLO greeting. Defaults to the APP_URL host;
# set it only if your relay requires a specific value.
#MAIL_EHLO_DOMAIN=

MAIL_FROM_ADDRESS='mesoftware@uni-bremen.de'
MAIL_FROM_NAME='Metag Analyze'

# Only used when MAIL_MAILER=log; empty means the default log channel.
MAIL_LOG_CHANNEL=

# Verify the settings above at any time with:
#   php artisan mail:sendtest you@example.org

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
# Maximum number of studies per user
MAX_NUMBER_STUDIES=10

# Admin email for system notifications
LINGUA_ADMIN=

# Comma-separated admin emails
ADMINS=

# Comma-separated blocked IP addresses
BLOCKED_IPS=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# HMAC key for Altcha human verification
# Generate with: openssl rand -hex 32
ALTCHA_HMAC_KEY=

# -----------------------------------------------------------------------------
# API DOCUMENTATION
# -----------------------------------------------------------------------------
# HTTP Basic Auth for /docs/api
# API_DOCS_PROTECT_ACCESS=false serves the docs openly: fine locally, never on a
# server. With it true, the credentials below are required, and an empty
# API_DOCS_PASSWORD disables docs access (returns 503).
# Generate password with: openssl rand -hex 24
API_DOCS_PROTECT_ACCESS=true
API_DOCS_USER=docs
API_DOCS_PASSWORD=

# -----------------------------------------------------------------------------
# REVERSE PROXY
# -----------------------------------------------------------------------------
# Proxies in front of the app, comma-separated IPs or '*'. Leave empty when
# there is none. Behind a TLS-terminating proxy this must be set, or Laravel
# ignores X-Forwarded-Proto and generates http:// URLs for an https:// site.
TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# PERFORMANCE
# -----------------------------------------------------------------------------
OPCACHE=true

# -----------------------------------------------------------------------------
# PUSHER (Websockets)
# -----------------------------------------------------------------------------
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
